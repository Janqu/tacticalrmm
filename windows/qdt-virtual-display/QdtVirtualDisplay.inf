;
; QdtVirtualDisplay.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=QdtVirtualDisplay.cat
DriverVer=10/15/2026,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...19041

[Standard.NTamd64.10.0...19041]
%DeviceName%=MyDevice_Install, Root\QDTVirtualDisplay

[SourceDisksFiles]
QdtVirtualDisplay.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR,, "MonitorCount",  %REG_DWORD%, 1
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "QdtVirtualDisplayGroup"

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=QdtVirtualDisplay,QdtVirtualDisplay_Install
UmdfServiceOrder=QdtVirtualDisplay
UmdfKernelModeClientPolicy = AllowKernelModeClients

[QdtVirtualDisplay_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%13%\QdtVirtualDisplay.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=13

[UMDriverCopy]
QdtVirtualDisplay.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="QDT"
DiskName = "QDT Virtual Display Installation Disk"
DeviceName="QDT Virtual Display"

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000
REG_DWORD     = 0x00010001
